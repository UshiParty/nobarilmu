# Salin jadi .env di STB:  cp .env.example .env   lalu isi nilainya.
# File .env JANGAN di-commit ke GitHub.

# Rahasia untuk menandatangani token login. Buat dengan:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Token Cloudflare Tunnel (dari dashboard Cloudflare, tunnel k02-nobarilmu)
TUNNEL_TOKEN=

# URL publik, dipakai untuk membuat wsUrl ruang nobar
PUBLIC_BASE_URL=https://kelompokFarizRiko.stei.site/api

# Kata sandi untuk 3 akun uji yang dibuat otomatis saat database kosong
# (kurator@nobarilmu.test, riko@nobarilmu.test, fariz@nobarilmu.test). Minimal 8 karakter.
SEED_PASSWORD=

# Opsional: API key uji untuk kelompok lain (grup "kelompok-uji"). Kosongkan kalau tidak perlu.
DEMO_API_KEY=

# Opsional: YouTube Data API key supaya judul & durasi video sumbangan terisi otomatis.
YOUTUBE_API_KEY=
